las,monospace;color:#18865a;text-align:right\">+3.63%</td><td style=\"padding:3px 0;font-size:12px;color:#5d686c\"></td></tr><tr style=\"border-top:1px solid #d5d9d2\"><td style=\"padding:3px 10px 3px 0;white-space:nowrap\">台股加權</td><td style=\"padding:3px 10px 3px 0;font-family:Menlo,Consolas,monospace;text-align:right\">39,338.92</td><td style=\"padding:3px 10px 3px 0;font-family:Menlo,Consolas,monospace;color:#18865a;text-align:right\">+0.48%</td><td style=\"padding:3px 0;font-size:12px;color:#5d686c\"></td></tr></table><div style=\"margin-top:6px\"><b style=\"font-size:13px\">對我們策略的影響（有回測支持的）</b><div style=\"font-size:13px;margin:2px 0\">・費半在 200 日均線之下（-19.8%）：新高突破訊號暫停（回測這時平均虧損）。</div><div style=\"font-size:13px;margin:2px 0\">・VIX 26.8：恐慌偏高，歷史上多頭回檔訊號最好（約 +0.11～0.14R）。</div></div><div style=\"font-size:11px;color:#5d686c;margin-top:2px\">VIX／殖利率／美元：紅色＝上升（對股市偏壓力）。期貨為最新報價，指數為最近收盤。</div>\n<h2 style=\"font-size:20px;margin:14px 0 4px;padding:6px 10px;background:#f3e3c3;color:#182024;border-radius:4px\">₿ 加密貨幣區</h2>\n<div style=\"font-size:15px;margin:8px 0 2px\">BTC 日線方向 <b style=\"font-size:26px;color:#c43d35\">-7</b> 空頭\n<span style=\"color:#5d686c\">・現價 61,419.47・200 日均線之下</span></div>\n<p style=\"margin:4px 0 16px;font-weight:bold\">BTC 空頭明確：只考慮做空。</p>\n<h3 style=\"font-size:16px;margin:0 0 8px\">今日策略建議</h3>\n<p style=\"color:#5d686c\">今天沒有回測支持的進場機會。</p><h3 style=\"font-size:16px;margin:20px 0 6px\">觀察名單（距觸發 3% 內）</h3><table style=\"border-collapse:collapse;font-size:14px\"><tr><td style=\"padding:3px 12px 3px 0\">TRX</td><td style=\"padding:3px 12px 3px 0\">短線（4H）</td><td style=\"padding:3px 12px 3px 0;color:#c43d35\">做空</td><td style=\"padding:3px 12px 3px 0;font-family:Menlo,Consolas,monospace\">收盤跌破 0.30170</td><td style=\"padding:3px 0;font-family:Menlo,Consolas,monospace\">-1.21%</td></tr><tr><td style=\"padding:3px 12px 3px 0\">TRUMP</td><td style=\"padding:3px 12px 3px 0\">短線（4H）</td><td style=\"padding:3px 12px 3px 0;color:#c43d35\">做空</td><td style=\"padding:3px 12px 3px 0;font-family:Menlo,Consolas,monospace\">收盤跌破 0.85500</td><td style=\"padding:3px 0;font-family:Menlo,Consolas,monospace\">-1.95%</td></tr><tr><td style=\"padding:3px 12px 3px 0\">BTC</td><td style=\"padding:3px 12px 3px 0\">短線（4H）</td><td style=\"padding:3px 12px 3px 0;color:#c43d35\">做空</td><td style=\"padding:3px 12px 3px 0;font-family:Menlo,Consolas,monospace\">收盤跌破 59,915.00</td><td style=\"padding:3px 0;font-family:Menlo,Consolas,monospace\">-2.45%</td></tr><tr><td style=\"padding:3px 12px 3px 0\">XLM</td><td style=\"padding:3px 12px 3px 0\">短線（4H）</td><td style=\"padding:3px 12px 3px 0;color:#c43d35\">做空</td><td style=\"padding:3px 12px 3px 0;font-family:Menlo,Consolas,monospace\">收盤跌破 0.12540</td><td style=\"padding:3px 0;font-family:Menlo,Consolas,monospace\">-2.49%</td></tr><tr><td style=\"padding:3px 12px 3px 0\">XRP</td><td style=\"padding:3px 12px 3px 0\">短線（4H）</td><td style=\"padding:3px 12px 3px 0;color:#c43d35\">做空</td><td style=\"padding:3px 12px 3px 0;font-family:Menlo,Consolas,monospace\">收盤跌破 0.93380</td><td style=\"padding:3px 0;font-family:Menlo,Consolas,monospace\">-2.75%</td></tr><tr><td style=\"padding:3px 12px 3px 0\">CAKE</td><td style=\"padding:3px 12px 3px 0\">短線（4H）</td><td style=\"padding:3px 12px 3px 0;color:#c43d35\">做空</td><td style=\"padding:3px 12px 3px 0;font-family:Menlo,Consolas,monospace\">收盤跌破 1.5520</td><td style=\"padding:3px 0;font-family:Menlo,Consolas,monospace\">-2.82%</td></tr></table>\n<h2 style=\"font-size:20px;margin:26px 0 4px;padding:6px 10px;background:#dfe8f1;color:#182024;border-radius:4px\">🇺🇸 美股區</h2>\n<div style=\"font-size:15px;margin:8px 0 2px\">QQQ 日線方向 <b style=\"font-size:26px;color:#c43d35\">-5</b> 空頭<span style=\"color:#5d686c\">・633.93・200 日均線之下・資料日 2026-11-25（美東收盤）</span></div><h3 style=\"font-size:16px;margin:12px 0 6px\">今晚買進</h3><p style=\"font-size:13px;color:#b9770e;margin:0 0 8px\">費半在 200 日均線之下：新高突破訊號今天不做（回測這時平均虧損）。</p><p style=\"color:#5d686c;margin:0\">今晚沒有要買的。</p><p style=\"font-size:12px;color:#5d686c;margin:12px 0 0\"><b>兩種訊號：</b>新高突破＝收盤創一年新高、放量、在 200 日均線之上；20 年 951 筆，平均 +0.26R，勝率約 36%，靠少數大賺。多頭回檔＝長期多頭裡短線急跌；4873 筆，勝率約 63%，但平均只有 +0.03R，小賺型，所以倉位較小。只做多（股票做空 20 年長期虧損）。</p><p style=\"font-size:12px;color:#5d686c;margin:6px 0 0\"><b>券商怎麼設：</b>①開盤後下市價買單 ②成交後馬上掛「停損單（Stop／停損市價）」，價格填信上的停損價，效期選 GTC／長效 ③之後每天早上看信：寫「今晚開盤賣出」那天，開盤下市價賣單，再取消原本的停損單。</p><h3 style=\"font-size:16px;margin:22px 0 4px\">觀察清單狀態（含商品）</h3><p style=\"margin:0 0 6px;font-size:12px;color:#5d686c\">報價為 Hyperliquid 股票／商品永續合約。20 年回測顯示：結構訊號在美股與商品上沒有勝過隨機進場，股票做空長期平均虧損，所以這裡只描述狀態與環境，不給進場建議。</p><table style=\"border-collapse:collapse;font-size:14px;width:100%\"><tr style=\"color:#5d686c;font-size:12px\"><td>標的</td><td>價格</td><td>日線分數</td><td>狀態</td></tr><tr style=\"border-top:1px solid #d5d9d2\"><td style=\"padding:6px 10px 6px 0;vertical-align:top;white-space:nowrap\"><b>QQQ（那斯達克 100）</b></td><td style=\"padding:6px 10px 6px 0;vertical-align:top;font-family:Menlo,Consolas,monospace;white-space:nowrap\">26,682.00<br><span style=\"color:#18865a;font-size:12px\">7日 +0.9%</span></td><td style=\"padding:6px 10px 6px 0;vertical-align:top;color:#c43d35;white-space:nowrap\">-7</td><td style=\"padding:6px 0;vertical-align:top;font-size:13px\">日線空頭（-7），在 200 日均線之下，等待：收盤站上 27,029.00 轉多（+1.3%）。空頭環境：歷史上股票做空平均仍是虧的，建議觀望而不是放空</td></tr><tr style=\"border-top:1px solid #d5d9d2\"><td style=\"padding:6px 10px 6px 0;vertical-align:top;white-space:nowrap\"><b>MSTR</b></td><td style=\"padding:6px 10px 6px 0;vertical-align:top;font-family:Menlo,Consolas,monospace;white-space:nowrap\">83.883<br><span style=\"color:#c43d35;font-size:12px\">7日 -2.8%</span></td><td style=\"padding:6px 10px 6px 0;vertical-align:top;color:#c43d35;white-space:nowrap\">-7</td><td style=\"padding:6px 0;vertical-align:top;font-size:13px\">日線空頭（-7），在 200 日均線之下，等待：收盤站上 93.34 轉多（+11.3%）。空頭環境：歷史上股票做空平均仍是虧的，建議觀望而不是放空</td></tr><tr style=\"border-top:1px solid #d5d9d2\"><td style=\"padding:6px 10px 6px 0;vertical-align:top;white-space:nowr