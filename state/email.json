o,Consolas,monospace;text-align:right\">19.420</td><td style=\"padding:3px 10px 3px 0;font-family:Menlo,Consolas,monospace;color:#c43d35;text-align:right\">+12.91%</td><td style=\"padding:3px 0;font-size:12px;color:#5d686c\"></td></tr><tr style=\"border-top:1px solid #d5d9d2\"><td style=\"padding:3px 10px 3px 0;white-space:nowrap\">美 10 年期殖利率</td><td style=\"padding:3px 10px 3px 0;font-family:Menlo,Consolas,monospace;text-align:right\">4.929%</td><td style=\"padding:3px 10px 3px 0;font-family:Menlo,Consolas,monospace;color:#18865a;text-align:right\">-6bp</td><td style=\"padding:3px 0;font-size:12px;color:#5d686c\">20 日 -35bp</td></tr><tr style=\"border-top:1px solid #d5d9d2\"><td style=\"padding:3px 10px 3px 0;white-space:nowrap\">美元指數 DXY</td><td style=\"padding:3px 10px 3px 0;font-family:Menlo,Consolas,monospace;text-align:right\">101.96</td><td style=\"padding:3px 10px 3px 0;font-family:Menlo,Consolas,monospace;color:#18865a;text-align:right\">-0.07%</td><td style=\"padding:3px 0;font-size:12px;color:#5d686c\"></td></tr><tr style=\"border-top:1px solid #d5d9d2\"><td style=\"padding:3px 10px 3px 0;white-space:nowrap\">WTI 原油</td><td style=\"padding:3px 10px 3px 0;font-family:Menlo,Consolas,monospace;text-align:right\">102.95</td><td style=\"padding:3px 10px 3px 0;font-family:Menlo,Consolas,monospace;color:#18865a;text-align:right\">+0.93%</td><td style=\"padding:3px 0;font-size:12px;color:#5d686c\"></td></tr><tr style=\"border-top:1px solid #d5d9d2\"><td style=\"padding:3px 10px 3px 0;white-space:nowrap\">布蘭特原油</td><td style=\"padding:3px 10px 3px 0;font-family:Menlo,Consolas,monospace;text-align:right\">112.33</td><td style=\"padding:3px 10px 3px 0;font-family:Menlo,Consolas,monospace;color:#c43d35;text-align:right\">-2.22%</td><td style=\"padding:3px 0;font-size:12px;color:#5d686c\"></td></tr><tr style=\"border-top:1px solid #d5d9d2\"><td style=\"padding:3px 10px 3px 0;white-space:nowrap\">黃金</td><td style=\"padding:3px 10px 3px 0;font-family:Menlo,Consolas,monospace;text-align:right\">3,884.90</td><td style=\"padding:3px 10px 3px 0;font-family:Menlo,Consolas,monospace;color:#c43d35;text-align:right\">-3.63%</td><td style=\"padding:3px 0;font-size:12px;color:#5d686c\"></td></tr><tr style=\"border-top:1px solid #d5d9d2\"><td style=\"padding:3px 10px 3px 0;white-space:nowrap\">台股加權</td><td style=\"padding:3px 10px 3px 0;font-family:Menlo,Consolas,monospace;text-align:right\">45,211.83</td><td style=\"padding:3px 10px 3px 0;font-family:Menlo,Consolas,monospace;color:#c43d35;text-align:right\">-2.49%</td><td style=\"padding:3px 0;font-size:12px;color:#5d686c\"></td></tr></table><div style=\"margin-top:6px\"><b style=\"font-size:13px\">對我們策略的影響（有回測支持的）</b><div style=\"font-size:13px;margin:2px 0\">・費半在 200 日均線之下（-0.9%）：新高突破訊號暫停（回測這時平均虧損）。</div><div style=\"font-size:13px;margin:2px 0\">・VIX 19.4：偏低，多頭回檔訊號優勢很小（約 0～0.07R）。</div></div><div style=\"font-size:11px;color:#5d686c;margin-top:2px\">VIX／殖利率／美元：紅色＝上升（對股市偏壓力）。期貨為最新報價，指數為最近收盤。</div>\n<h2 style=\"font-size:20px;margin:14px 0 4px;padding:6px 10px;background:#f3e3c3;color:#182024;border-radius:4px\">₿ 加密貨幣區</h2>\n<div style=\"font-size:15px;margin:8px 0 2px\">BTC 日線方向 <b style=\"font-size:26px;color:#c43d35\">-1</b> 震盪\n<span style=\"color:#5d686c\">・現價 76,970.35・200 日均線之上</span></div>\n<p style=\"margin:4px 0 16px;font-weight:bold\">BTC 在震盪區：回測中這種時候進場平均是虧的，今天觀望。</p>\n<h3 style=\"font-size:16px;margin:0 0 8px\">今日策略建議</h3>\n<p style=\"color:#5d686c\">今天沒有回測支持的進場機會。</p>\n<h2 style=\"font-size:20px;margin:26px 0 4px;padding:6px 10px;background:#dfe8f1;color:#182024;border-radius:4px\">🇺🇸 美股區</h2>\n<div style=\"font-size:15px;margin:8px 0 2px\">QQQ 日線方向 <b style=\"font-size:26px;color:#c43d35\">-3</b> 偏空<span style=\"color:#5d686c\">・690.49・200 日均線之上・資料日 2026-10-30（美東收盤）</span></div><h3 style=\"font-size:16px;margin:12px 0 6px\">今晚買進</h3><p style=\"font-size:13px;color:#b9770e;margin:0 0 8px\">費半在 200 日均線之下：新高突破訊號今天不做（回測這時平均虧損）。</p><div style=\"border:1px solid #d5d9d2;border-left:5px solid #18865a;border-radius:6px;padding:12px 16px;margin:0 0 12px\"><div style=\"font-size:20px;font-weight:bold;color:#18865a\">SHOP　買進<span style=\"font-size:13px;color:#182024;font-weight:normal\">　多頭回檔（小賺型）・10-30 收盤觸發</span></div><table style=\"border-collapse:collapse;font-size:14px;margin-top:8px\"><tr><td style=\"padding:4px 10px 4px 0;color:#5d686c;vertical-align:top;white-space:nowrap\">什麼時候</td><td style=\"padding:4px 0;color:#182024\">今晚美股開盤（台北 11-02 22:30）</td></tr><tr><td style=\"padding:4px 10px 4px 0;color:#5d686c;vertical-align:top;white-space:nowrap\">怎麼買</td><td style=\"padding:4px 0;color:#182024\">市價單買進（參考昨收 157.49）</td></tr><tr><td style=\"padding:4px 10px 4px 0;color:#5d686c;vertical-align:top;white-space:nowrap\">停損單</td><td style=\"padding:4px 0;color:#182024\">138.98，買到後立刻掛「停損市價單、長效 GTC」（距昨收 11.8%）</td></tr><tr><td style=\"padding:4px 10px 4px 0;color:#5d686c;vertical-align:top;white-space:nowrap\">怎麼賣</td><td style=\"padding:4px 0;color:#182024\">哪天收盤站上 5 日均線，隔天開盤賣（信會提醒）；最長 10 個交易日</td></tr><tr><td style=\"padding:4px 10px 4px 0;color:#5d686c;vertical-align:top;white-space:nowrap\">買多少</td><td style=\"padding:4px 0;color:#182024\">本金的 2.1%（本金 10 萬 → 買約 2,127 的股票）；打到停損只虧本金 0.25%</td></tr><tr><td style=\"padding:4px 10px 4px 0;color:#5d686c;vertical-align:top;white-space:nowrap\">回測</td><td style=\"padding:4px 0;color:#182024\">20 年 4850 筆，勝率 63%，平均 +0.03R（樣本外 +0.06R）</td></tr></table></div><div style=\"border:1px solid #d5d9d2;border-left:5px solid #18865a;border-radius:6px;padding:12px 16px;margin:0 0 12px\"><div style=\"font-size:20px;font-weight:bold;color:#18865a\">PLTR　買進<span style=\"font-size:13px;color:#182024;font-weight:normal\">　多頭回檔（小賺型）・10-30 收盤觸發</span></div><table style=\"border-collapse:collapse;font-size:14px;margin-top:8px\"><tr><td style=\"padding:4px 10px 4px 0;color:#5d686c;vertical-align:top;white-space:nowrap\">什麼時候</td><td style=\"padding:4px 0;color:#182024\">今晚美股開盤（台北 11-02 22:30）</td></tr><tr><td style=\"padding:4px 10px 4px 0;color:#5d686c;vertical-align:top;white-space:nowrap\">怎麼買</td><td style=\"padding:4px 0;color:#182024\">市價單買進（參考昨收 184.11）</td></tr><tr><td style=\"padding:4px 10px 4px 0;color:#5d686c;vertical-align:top;white-space:nowrap\">停損單</td><td style=\"padding:4px 0;color:#182024\">163.92，買到後立刻掛「停損市價單、長效 GTC」（距昨收 11.0%）</td></tr><tr><td style=\"padding:4px 10px 4px 0;color:#5d686c;vertical-align:top;white-space:nowrap\">怎麼賣</td><td style=\"padding:4px 0;color:#182024\">哪天收盤站上 5 日均線，隔天開盤賣（信會提醒）；最長 10 個交易日</td></tr><tr><td style=\"padding:4px 10px 4px 0;color:#5d686c;vertical-align:top;white-space:nowrap\">買多少</td><td style=\"padding:4px 0;color:#182024\">本金的 2.3%（本金 10 萬 → 買約 2,279 的股票）；打到停損只虧本金 0.25%</td></tr><tr><td style=\"padding:4px 10px 4px 0;color:#5d686c;vertical-align:top;white-space:nowrap\">回測</td><td style=\"padding:4px 0;color:#182024\">20 年 4850 筆，勝率 63%，平均 +0.03R（樣本外 +0.06R）</td></tr></table></div><div style=\"border:1px solid #d5d9d2;border-left:5px solid #18865a;border-radius:6px;padding:12px 16px;margin:0 0 12px\"><div style=\"font-size:20px;font-weight:bold;color:#18865a\">MSFT　買進<span style=\"font-size:13px;color:#182024;font-weight:normal\">　多頭回檔（小賺型）・10-30 收盤觸發</span></div><table style=\"border-collapse:collapse;font-size:14px;margin-top:8px\"><tr><td style=\"padding:4px 10px 4px 0;color:#5d686c;vertical-align:top;white-space:nowrap\">什麼時候</td><td style=\"padding:4px 0;color:#182024\">今晚美股開盤（台北 11-02 22:30）</td></tr><tr><td style=\"padding:4px 10px 4px 0;color:#5d686c;vertical-align:top;white-space:nowrap\">怎麼買</td><td style=\"padding:4px 0;color:#182024\">市價單買進（參考昨收 521.91）</td></tr><tr><td style=\"padding:4px 10px 4px 0;color:#5d686c;vertical-align:top;white-space:nowrap\">停損單</td><td style=\"padding:4px 0;color:#182024\">492.21，買到後立刻掛「停損市價單、長效 GTC」（距昨收 5.7%）</td></tr><tr><td style=\"padding:4px 10px 4px 0;color:#5d686c;vertical-align:top;white-space:nowrap\">怎麼賣</td><td style=\"padding:4px 0;color:#182024\">哪天收盤站上 5 日均線，隔天開盤賣（信會提醒）；最長 10 個交易日</td></tr><tr><td style=\"padding:4px 10px 4px 0;color:#5d686c;vertical-align:top;white-space:nowrap\">買多少</td><td style=\"padding:4px 0;color:#182024\">本金的 4.4%（本金 10 萬 → 買約 4,394 的股票）；打到停損只虧本金 0.25%</td></tr><tr><td style=\"padding:4px 10px 4px 0;color:#5d686c;vertical-align:top;white-space:nowrap\">回測</td><td style=\"padding:4px 0;color:#182024\">20 年 4850 筆，勝率 63%，平均 +0.03R（樣本外 +0.06R）</td></tr></table></div><p style=\"font-size:13px;margin:14px 0 0\"><b>其他也有觸發、但不建議再買的：</b>CRM、MRVL、SPY、QQQ、TSM、NVDA。<span style=\"color:#5d686c\">同一天觸發很多檔代表大盤一起跌，這些幾乎是同一個賭注；系統只挑長期趨勢最強（離 200 日均線最遠）的前 3 檔，回測比全買好。</span></p><p style=\"font-size:12px;color:#5d686c;margin:12px 0 0\"><b>兩種訊號：</b>新高突破＝收盤創一年新高、放量、在 200 日均線之上；20 年 951 筆，平均 +0.26R，勝率約 36%，靠少數大賺。多頭回檔＝長期多頭裡短線急跌；4850 筆，勝率約 63%，但平均只有 +0.03R，小賺型，所以倉位較小。只做多（股票做空 20 年長期虧損）。</p><p style=\"font-size:12px;color:#5d686c;margin:6px 0 0\"><b>券商怎麼設：</b>①開盤後下市價買單 ②成交後馬上掛「停損單（Stop／停損市價）」，價格填信上的停損價，效期選 GTC／長效 ③之後每天早上看信：寫「今晚開盤賣出」那天，開盤下市價賣單，再取消原本的停損單。</p><h3 style=\"font-size:16px;margin:22px 0 4px\">觀察清單狀態（含商品）</h3><p style=\"margin:0 0 6px;font-size:12px;color:#5d686c\">報價為 Hyperliquid 股票／商品永續合約。20 年回測顯示：結構訊號在美股與商品上沒有勝過隨機進場，股票做空長期平均虧損，所以這裡只描述狀態與環境，不給進場建議。</p><table style=\"border-collapse:collapse;font-size:14px;width:100%\"><tr style=\"color:#5d686c;font-size:12px\"><td>標的</td><td>價格</td><td>日線分數</td><td>狀態</td></tr><tr style=\"border-top:1px solid #d5d9d2\"><td style=\"padding:6px 10px 6px 0;vertical-align:top;white-space:nowrap\"><b>QQQ（那斯達克 100）</b></td><td style=\"padding:6px 10px 6px 0;vertical-align:top;font-family:Menlo,Consolas,monospace;white-space:nowrap\">28,397.00<br><span style=\"color:#c43d35;font-size:12px\">7日 -1.8%</span></td><td style=\"padding:6px 10px 6px 0;vertical-align:top;color:#c43d35;white-space:nowrap\">-3</td><td style=\"padding:6px 0;vertical-align:top;font-size:13px\">日線偏空（-3），在 200 日均線之下，等待：收盤跌破 28,810.00 轉空（+1.5%）。震盪：歷史上進場平均略虧</td></tr><tr style=\"border-top:1px solid #d5d9d2\"><td style=\"padding: